{
  "name": "@youngjurry/pi-agents",
  "version": "0.7.3",
  "description": "Persistent in-process Codex-style multi-agent collaboration for Pi",
  "author": "youngjurry",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "multi-agent",
    "subagent",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoungJurry/pi-agents.git"
  },
  "homepage": "https://github.com/YoungJurry/pi-agents#readme",
  "bugs": {
    "url": "https://github.com/YoungJurry/pi-agents/issues"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run check && npm test"
  },
  "files": [
    "*.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-agent-core": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
